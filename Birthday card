<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Ultimate Birthday Card 🎂</title>

<style>
body {
    margin: 0;
    font-family: 'Segoe UI', sans-serif;
    background: radial-gradient(circle, #ff9a9e, #fad0c4);
    overflow: hidden;
}

/* Card container */
.card {
    width: 320px;
    height: 420px;
    margin: 100px auto;
    perspective: 1200px;
    cursor: pointer;
}

.inner {
    width: 100%;
    height: 100%;
    transition: transform 1s;
    transform-style: preserve-3d;
    position: relative;
}

.card.open .inner {
    transform: rotateY(180deg);
}

.front, .back {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 20px;
    backface-visibility: hidden;
    box-shadow: 0 15px 30px rgba(0,0,0,0.3);
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
}

.front {
    background: linear-gradient(135deg, #ff6f91, #ff9671);
    color: white;
    font-size: 26px;
    font-weight: bold;
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
}

.back {
    background: white;
    transform: rotateY(180deg);
    padding: 20px;
    text-align: center;
}

/* Glow text */
.glow {
    font-size: 22px;
    color: #ff3f6c;
    text-shadow: 0 0 10px #ff6f91;
}

/* Button */
button {
    margin-top: 15px;
    padding: 10px 18px;
    border: none;
    border-radius: 10px;
    background: #ff6f91;
    color: white;
    cursor: pointer;
    font-weight: bold;
}

button:hover {
    background: #ff3f6c;
}

/* Typewriter text */
#message {
    margin-top: 15px;
    font-size: 16px;
    min-height: 60px;
}

/* Image */
img {
    width: 80px;
    border-radius: 50%;
    margin-bottom: 10px;
}

/* Confetti */
.confetti {
    position: fixed;
    width: 10px;
    height: 10px;
    background: red;
    top: 0;
    animation: fall linear forwards;
}

@keyframes fall {
    to {
        transform: translateY(100vh) rotate(720deg);
        opacity: 0;
    }
}
</style>
</head>

<body>

<!-- Background music -->
<audio id="music" src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3"></audio>

<div class="card" onclick="openCard()">
    <div class="inner">
        <div class="front">
            🎉 TAP TO OPEN 🎉
        </div>

        <div class="back">
            <img src="https://i.imgur.com/4M34hi2.png" alt="avatar">

            <div class="glow">🎂 Happy Birthday! 🎂</div>

            <div id="message"></div>

            <button onclick="startSurprise(event)">Open Surprise 🎁</button>
        </div>
    </div>
</div>

<script>
let opened = false;

function openCard() {
    document.querySelector('.card').classList.toggle('open');

    if (!opened) {
        document.getElementById("music").play();
        opened = true;
    }
}

function startSurprise(event) {
    event.stopPropagation();
    typeWriter();
    launchConfetti();
}

const text = "You’re not just special today… you’re unforgettable every single day. 💖";

let i = 0;
function typeWriter() {
    if (i < text.length) {
        document.getElementById("message").innerHTML += text.charAt(i);
        i++;
        setTimeout(typeWriter, 40);
    }
}

/* Confetti generator */
function launchConfetti() {
    for (let i = 0; i < 80; i++) {
        let conf = document.createElement("div");
        conf.classList.add("confetti");
        document.body.appendChild(conf);

        conf.style.left = Math.random() * window.innerWidth + "px";
        conf.style.background = randomColor();
        conf.style.animationDuration = (2 + Math.random() * 3) + "s";

        setTimeout(() => conf.remove(), 5000);
    }
}

function randomColor() {
    const colors = ["#ff6f91", "#ffc75f", "#845ec2", "#00c9a7"];
    return colors[Math.floor(Math.random() * colors.length)];
}
</script>

</body>
</html>
